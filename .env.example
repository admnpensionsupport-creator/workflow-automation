# ─── Resend Email ───────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=reports@yourdomain.com
EMAIL_TO=you@example.com,team@example.com
EMAIL_SUBJECT_PREFIX=Daily Report

# ─── Supabase ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_TABLE=your_table_name
# SUPABASE_FILTER_COLUMN=status
# SUPABASE_FILTER_VALUE=active

# ─── Workflow Config ───────────────────────────────
# Options: "supabase" (default)
# To add Google Sheets, set up a service account and see README
DATA_SOURCE=supabase

# Cron expression (default: 7:00 AM daily)
CRON_SCHEDULE=0 7 * * *

# Local CSV output directory (auto-cleaned after email)
# LOCAL_OUTPUT_DIR=./output

# ─── Optional: Google Sheets + Drive ───────────────
# Requires a Google service account JSON key.
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json
# GOOGLE_SHEET_ID=your-google-sheet-id-from-url
# GOOGLE_SHEET_RANGE=Sheet1!A1:Z1000
# GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# ─── Pipedrive Sync ───────────────────────────────
PIPEDRIVE_API_KEY=your-pipedrive-api-token
# GSHEET_CONTACTS_ID=your-google-sheet-id            # defaults to FSJ contacts sheet
# GSHEET_CONTACTS_RANGE=Sheet1!A1:Z500               # default range
# PIPEDRIVE_SYNC_CRON=*/15 * * * *                    # every 15 min (--cron mode)
